TELEGRAM_BOT_TOKEN=isi_token_dari_botfather
# ID Telegram numerik, pisahkan dengan koma untuk beberapa admin.
ADMIN_IDS=5174594717
SHOP_NAME=Bersama Store
# Path ke file banner PNG untuk /start (opsional, kosongkan untuk tanpa gambar).
BANNER_PATH=public/banner.png
PAYMENT_PROVIDER=pakasir
# Slug dan API Key dari halaman proyek di app.pakasir.com. Jangan commit API Key asli.
PAKASIR_PROJECT=slug-proyek-anda
PAKASIR_API_KEY=isi_api_key_pakasir
# Hanya dipakai jika PAYMENT_PROVIDER=manual; kosongkan untuk Pakasir.
PAYMENT_INSTRUCTIONS=
SUPPORT_CONTACT=@username_admin
# PostgreSQL connection string
PG_DSN=dbname=postgres user=postgres password=postgres host=localhost port=5432
ORDER_TTL_HOURS=24
# URL HTTPS web app untuk Mini Apps (contoh: https://yourdomain.com).
# Server web/Vercel harus memakai TELEGRAM_BOT_TOKEN yang sama untuk verifikasi initData.
WEBAPP_URL=
# Channel publik wajib untuk /start (dengan/tanpa @); kosong = tanpa syarat join.
# Tambahkan bot sebagai administrator channel agar getChatMember dapat memeriksa pengguna.
CHANNEL_USERNAME=
